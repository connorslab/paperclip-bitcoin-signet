[Unit]
Description=Paperclip limited Bitcoin signet faucet
After=bitcoin-signet.service
[Service]
User=bitcoin-signet
Group=bitcoin-signet
ExecStart=/usr/bin/python3 /opt/paperclip-signet-explorer/faucet.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=paperclip-signet-faucet
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paperclip-signet-faucet
InaccessiblePaths=/var/lib/paperclip-bitcoin-signet/signer.hex /var/lib/paperclip-bitcoin-signet/signet/wallets
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=100M
CPUQuota=20%
TasksMax=8
[Install]
WantedBy=multi-user.target
