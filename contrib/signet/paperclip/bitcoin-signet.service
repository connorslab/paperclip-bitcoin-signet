[Unit]
Description=Paperclip experimental Bitcoin covenant signet
After=network-online.target
Wants=network-online.target
[Service]
User=bitcoin-signet
Group=bitcoin-signet
ExecStart=/opt/paperclip-bitcoin-signet/bin/bitcoind -datadir=/var/lib/paperclip-bitcoin-signet -printtoconsole
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
Nice=10
MemoryHigh=320M
MemoryMax=450M
CPUQuota=100%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paperclip-bitcoin-signet
[Install]
WantedBy=multi-user.target
